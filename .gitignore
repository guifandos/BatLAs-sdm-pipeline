# ==============================================================================
# .gitignore - Iberian Bat SDM Pipeline
# ==============================================================================
# Versioned: R/, data/metadata/, data/simulated/, docs/, tests/, examples/,
# configuration (renv.lock, .Rprofile, renv/settings.json),
# CITATION.cff, LICENSE, README.md, imagenes/

# ==============================================================================
# LEGACY / OBSOLETE DIRECTORIES
# ==============================================================================
atlas_murcielagos_pipeline_26112025/
archivos_nuevos/

# ==============================================================================
# SHINY APP (not part of the public pipeline)
# ==============================================================================
shiny_atlas/
shiny_v2/
output_shiny/
output_shiny_2014/
preprocesar_output_shiny.R
preprocesar_output_shiny_2014.R

# ==============================================================================
# DATA (large / sensitive / reproducible)
# ==============================================================================

# --- Raw data (not distributed) ---
data/raw/

# --- Processed data (reproducible from raw) ---
data/processed/
data/processed_2014/

# --- Model-ready data (reproducible from processed) ---
data/modelado_ready/
data/modelado_ready_2014/

# --- Generic RDS exclusion (safety net) ---
*.rds

# --- Exception: simulated data IS versioned ---
!data/simulated/*.rds

